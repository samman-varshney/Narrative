// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum BlogVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  MEMBERS_ONLY
}

enum MediaResourceType {
  IMAGE
  VIDEO // reserved — not built yet
  DOCUMENT // reserved — not built yet
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
  BLOG
  SYSTEM
  // Reserved — the orchestrator and preference matrix already handle unknown
  // types by falling back to defaults, so adding one needs no code change here.
  MENTION // reserved — not built yet
  LIKE // reserved — not built yet
}

/// Channels with real delivery semantics. IN_APP is intentionally absent: it is
/// persisted directly as a Notification row and has nothing to track.
enum DeliveryChannel {
  EMAIL
  PUSH // reserved — not built yet
  SMS // reserved — not built yet
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  username     String  @unique
  bio          String? @db.Text
  avatar       String? // denormalized secureUrl of the current avatar (kept for convenience)
  role         Role    @default(USER)

  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 Relations
  profile          UserProfile?
  developerProfile DeveloperProfile?
  settings         UserSettings?

  // 1:N Relations
  blogs     Blog[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  notifications      Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  sessions      Session[]
  skills        UserSkill[]
  media         Media[]        @relation("MediaUploader")

  // Current avatar as a proper reference to its Media record (source of truth).
  avatarMediaId String? @unique
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([name])
}

model Media {
  id               String            @id @default(cuid())
  publicId         String            @unique // cloudinary public_id OR local filename
  url              String
  secureUrl        String
  originalFilename String
  mimeType         String // derived from sharp inspection, NOT the client-provided value
  extension        String
  fileSize         Int
  width            Int?
  height           Int?
  resourceType     MediaResourceType @default(IMAGE)
  provider         String // 'local' | 'cloudinary'
  checksum         String? // sha256 hex of the stored bytes
  metadata         Json? // { context, format, altText, ... }

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Back-relation for the user whose current avatar this media is (if any).
  avatarOf User? @relation("UserAvatar")

  // Back-relation for the blog whose current cover this media is (if any).
  coverOf Blog? @relation("BlogCover")

  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([uploadedById])
  @@index([deletedAt])
  @@index([resourceType])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location   String?
  occupation String?
  company    String?
}

model DeveloperProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  github        String?
  linkedin      String?
  portfolio     String?
  stackoverflow String?
  leetcode      String?
  codeforces    String?
  hackerrank    String?
  x             String?
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme    String @default("system")
  language String @default("en")
  timezone String @default("UTC")

  isPrivate    Boolean @default(false)
  hideEmail    Boolean @default(true)
  hideActivity Boolean @default(false)

  emailPreferences        Json?
  notificationPreferences Json?
}

model Blog {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  subtitle   String?
  content    Json?
  coverImage String?

  status     BlogStatus     @default(DRAFT)
  visibility BlogVisibility @default(PUBLIC)

  readingTimeMinutes Int   @default(0)
  wordCount          Int   @default(0)
  charCount          Int   @default(0)
  readingStats       Json? // { headingCount, imageCount, codeBlockCount } — extended reading metadata

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Current cover as a proper reference to its Media record (source of truth),
  // alongside the denormalized `coverImage` secureUrl. Mirrors User.avatar/avatarMediaId.
  coverMediaId String? @unique
  coverMedia   Media?  @relation("BlogCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  seo       BlogSEO?
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  tags       BlogTag[]
  categories BlogCategory[]

  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@index([status, publishedAt]) // published feed, newest-first cursor pagination
  @@index([authorId, status]) // "my blogs" / "my drafts"
}

model BlogSEO {
  id              String  @id @default(cuid())
  blogId          String  @unique
  blog            Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  twitterCard     String?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs BlogCategory[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs BlogTag[]
}

// Explicit join table for Blog <-> Tag. Explicit (over implicit m:n) so per-link
// metadata (e.g. addedAt, ordering) can be added without a relational migration.
model BlogTag {
  blogId  String
  tagId   String
  addedAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId]) // reverse lookup: blogs for a tag
}

// Explicit join table for Blog <-> Category.
model BlogCategory {
  blogId     String
  categoryId String
  addedAt    DateTime @default(now())

  blog     Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogId, categoryId])
  @@index([categoryId]) // reverse lookup: blogs for a category
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Threading: depth drives the max-nesting cap; path is the materialized ancestor
  // chain "<rootId>/<childId>/<selfId>" — a structural cycle guard and a future
  // O(1) subtree fetch (WHERE path startsWith <rootPath>).
  depth Int    @default(0)
  path  String @default("")

  // Editing (future-ready for full edit history)
  isEdited Boolean   @default(false)
  editedAt DateTime?

  // Lifecycle / moderation — tombstones stay in the tree so children remain visible.
  deletedAt DateTime? // author/admin soft delete
  isHidden  Boolean   @default(false) // admin moderation hide

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId, parentId, createdAt]) // top-level page (parentId IS NULL) + stable ordering
  @@index([parentId, createdAt]) // direct-children page / BFS descendant load
  @@index([authorId])
  @@index([blogId, deletedAt]) // per-blog comment counts
}

model Like {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate likes
  @@index([blogId])
  @@index([userId])
}

model Bookmark {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate bookmarks
  // Composite index optimizes the library's cursor pagination ordered by
  // createdAt AND covers the single-column userId filter used by the count
  // query (leftmost-prefix rule) — same treatment Follow received.
  @@index([userId, createdAt]) // "my bookmarks" list + per-user count
  @@index([blogId]) // per-blog bookmark count + cascade deletes
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId]) // Prevent duplicate follows
  // Composite indexes optimize cursor pagination ordered by createdAt AND cover
  // the single-column filters used by count queries (leftmost-prefix rule).
  @@index([followingId, createdAt]) // followers list + follower count
  @@index([followerId, createdAt]) // following list + following count
}

model Notification {
  id String @id @default(cuid())

  // Who receives it.
  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Who caused it. Null for SYSTEM notifications. SetNull (not Cascade) so a
  // deleted actor doesn't erase the recipient's history.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type NotificationType

  // What it points at, for deep links. entityType tells the client how to route.
  entityType String? // 'BLOG' | 'COMMENT' | 'USER'
  entityId   String?

  // Render inputs (blogTitle, commentExcerpt, ...) — NOT rendered text. Storing
  // a finished string would freeze it: a renamed user leaves stale copy behind
  // and UserSettings.language could never be honoured.
  metadata Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  /// Idempotency key: one notification per (recipient, event occurrence). Makes a
  /// retried fan-out job a no-op via createMany(skipDuplicates) / P2002.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]

  @@index([recipientId, createdAt]) // the list query, newest-first
  @@index([recipientId, isRead, createdAt]) // filtered list (unread only)
  @@index([entityType, entityId]) // future: "notifications about this blog"
  // NOTE: the unread COUNT is served by a partial index that Prisma cannot
  // express — see prisma/sql/notification_unread_idx.sql, applied by db:indexes.
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // In-app is deliberately NOT tracked: it has no delivery semantics, and a row
  // per in-app notification would double the write volume of every fan-out.
  channel  DeliveryChannel
  provider String? // 'resend' | 'log' | ...

  providerMessageId String?
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)

  sentAt   DateTime?
  failedAt DateTime?
  error    String?   @db.Text

  createdAt DateTime @default(now())

  @@unique([notificationId, channel]) // one delivery record per channel
  @@index([status, createdAt]) // retry sweeps / failure dashboards
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
}
