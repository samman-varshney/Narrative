// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Platform roles. The role is a COARSE bucket; the fine-grained capability
/// check is the permission catalogue in `modules/auth/permissions.ts`, which
/// maps each role to the permissions it holds. Adding a role (support admin,
/// content moderator, ...) is an entry here plus an entry there — no controller
/// or service changes, because nothing checks a role name directly.
enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE

  /// Self-service, reversible, and invisible to everyone else — the user asked
  /// to disappear. Distinct from SUSPENDED (imposed by a moderator, reversible
  /// only by one) and from DELETED (terminal). Reactivation happens on the next
  /// successful login: the password check IS the confirmation, so there is no
  /// separate token flow to build or expire.
  DEACTIVATED

  SUSPENDED
  DELETED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum BlogVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  MEMBERS_ONLY
}

enum MediaResourceType {
  IMAGE
  VIDEO // reserved — not built yet
  DOCUMENT // reserved — not built yet
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
  BLOG
  SYSTEM
  // Reserved — the orchestrator and preference matrix already handle unknown
  // types by falling back to defaults, so adding one needs no code change here.
  MENTION // reserved — not built yet
  LIKE // reserved — not built yet
}

/// Channels with real delivery semantics. IN_APP is intentionally absent: it is
/// persisted directly as a Notification row and has nothing to track.
enum DeliveryChannel {
  EMAIL
  PUSH // reserved — not built yet
  SMS // reserved — not built yet
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  username     String  @unique
  bio          String? @db.Text
  avatar       String? // denormalized secureUrl of the current avatar (kept for convenience)
  role         Role    @default(USER)

  /// The single account-status model on the platform. Moderation SUSPENDS by
  /// writing `SUSPENDED` here through `userService`, never by introducing a
  /// second flag — Auth already refuses a login and a refresh for it, and
  /// Feed/Search eligibility already excludes non-ACTIVE authors.
  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  verifiedAt DateTime?

  /// When the CURRENT suspension began, and why. Descriptive only: `status` is
  /// the enforcement point and the ModerationAction log is the audit record.
  /// Kept on the row so an admin viewing an account does not need a log query
  /// to answer "since when", and cleared on unsuspend.
  suspendedAt     DateTime?
  suspendedReason String?   @db.Text

  /// When the user deactivated themselves. Descriptive only, like `suspendedAt`:
  /// `status` is the enforcement point. Cleared on reactivation and on
  /// suspension, so it never describes an account that is not DEACTIVATED.
  /// No accompanying reason column — a self-service exit owes nobody one.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 Relations
  profile          UserProfile?
  developerProfile DeveloperProfile?
  settings         UserSettings?

  // 1:N Relations
  blogs     Blog[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  notifications      Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")

  // Moderation. Four separate relations because one user can appear in a report
  // in four distinct roles, and a single relation could not tell them apart.
  reportsFiled      Report[]           @relation("ReportReporter")
  reportsAssigned   Report[]           @relation("ReportAssignee")
  reportsResolved   Report[]           @relation("ReportResolver")
  moderationActions ModerationAction[] @relation("ModerationActor")

  analyticsDaily     UserAnalyticsDaily[]
  blogAnalyticsDaily BlogAnalyticsDaily[] @relation("BlogAnalyticsAuthor")
  sessions           Session[]
  skills             UserSkill[]
  media              Media[]              @relation("MediaUploader")

  // Current avatar as a proper reference to its Media record (source of truth).
  avatarMediaId String? @unique
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([name])
}

model Media {
  id               String            @id @default(cuid())
  publicId         String            @unique // cloudinary public_id OR local filename
  url              String
  secureUrl        String
  originalFilename String
  mimeType         String // derived from sharp inspection, NOT the client-provided value
  extension        String
  fileSize         Int
  width            Int?
  height           Int?
  resourceType     MediaResourceType @default(IMAGE)
  provider         String // 'local' | 'cloudinary'
  checksum         String? // sha256 hex of the stored bytes
  metadata         Json? // { context, format, altText, ... }

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Back-relation for the user whose current avatar this media is (if any).
  avatarOf User? @relation("UserAvatar")

  // Back-relation for the blog whose current cover this media is (if any).
  coverOf Blog? @relation("BlogCover")

  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([uploadedById])
  @@index([deletedAt])
  @@index([resourceType])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location   String?
  occupation String?
  company    String?
}

model DeveloperProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  github        String?
  linkedin      String?
  portfolio     String?
  stackoverflow String?
  leetcode      String?
  codeforces    String?
  hackerrank    String?
  x             String?
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme    String @default("system")
  language String @default("en")
  timezone String @default("UTC")

  isPrivate    Boolean @default(false)
  hideEmail    Boolean @default(true)
  hideActivity Boolean @default(false)

  emailPreferences        Json?
  notificationPreferences Json?
}

model Blog {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  subtitle   String?
  content    Json?
  coverImage String?

  status     BlogStatus     @default(DRAFT)
  visibility BlogVisibility @default(PUBLIC)

  /// Moderation hide — the blog-side twin of `Comment.isHidden`, which has
  /// carried exactly this meaning since the Comment module shipped.
  ///
  /// Deliberately NOT a new `BlogStatus` value and NOT a reuse of ARCHIVED:
  /// status is the AUTHOR's lifecycle (draft → published → archived) and the
  /// author can move it freely, so encoding a moderation decision there would
  /// let the author undo it with a normal publish. This is an orthogonal axis
  /// only moderation writes: while it is set, every author-side transition is
  /// refused and the blog is excluded from every discovery surface.
  isHidden Boolean   @default(false)
  hiddenAt DateTime?

  readingTimeMinutes Int   @default(0)
  wordCount          Int   @default(0)
  charCount          Int   @default(0)
  readingStats       Json? // { headingCount, imageCount, codeBlockCount } — extended reading metadata

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Current cover as a proper reference to its Media record (source of truth),
  // alongside the denormalized `coverImage` secureUrl. Mirrors User.avatar/avatarMediaId.
  coverMediaId String? @unique
  coverMedia   Media?  @relation("BlogCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  seo       BlogSEO?
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  tags       BlogTag[]
  categories BlogCategory[]

  analyticsDaily BlogAnalyticsDaily[]

  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@index([status, publishedAt]) // published feed, newest-first cursor pagination
  @@index([authorId, status]) // "my blogs" / "my drafts"
}

model BlogSEO {
  id              String  @id @default(cuid())
  blogId          String  @unique
  blog            Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  twitterCard     String?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs BlogCategory[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs BlogTag[]
}

// Explicit join table for Blog <-> Tag. Explicit (over implicit m:n) so per-link
// metadata (e.g. addedAt, ordering) can be added without a relational migration.
model BlogTag {
  blogId  String
  tagId   String
  addedAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId]) // reverse lookup: blogs for a tag
}

// Explicit join table for Blog <-> Category.
model BlogCategory {
  blogId     String
  categoryId String
  addedAt    DateTime @default(now())

  blog     Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogId, categoryId])
  @@index([categoryId]) // reverse lookup: blogs for a category
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Threading: depth drives the max-nesting cap; path is the materialized ancestor
  // chain "<rootId>/<childId>/<selfId>" — a structural cycle guard and a future
  // O(1) subtree fetch (WHERE path startsWith <rootPath>).
  depth Int    @default(0)
  path  String @default("")

  // Editing (future-ready for full edit history)
  isEdited Boolean   @default(false)
  editedAt DateTime?

  // Lifecycle / moderation — tombstones stay in the tree so children remain visible.
  deletedAt DateTime? // author/admin soft delete
  isHidden  Boolean   @default(false) // moderation hide
  hiddenAt  DateTime? // when the moderation hide was applied (null when visible)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId, parentId, createdAt]) // top-level page (parentId IS NULL) + stable ordering
  @@index([parentId, createdAt]) // direct-children page / BFS descendant load
  @@index([authorId])
  @@index([blogId, deletedAt]) // per-blog comment counts
}

model Like {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate likes
  @@index([blogId])
  @@index([userId])
}

model Bookmark {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate bookmarks
  // Composite index optimizes the library's cursor pagination ordered by
  // createdAt AND covers the single-column userId filter used by the count
  // query (leftmost-prefix rule) — same treatment Follow received.
  @@index([userId, createdAt]) // "my bookmarks" list + per-user count
  @@index([blogId]) // per-blog bookmark count + cascade deletes
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId]) // Prevent duplicate follows
  // Composite indexes optimize cursor pagination ordered by createdAt AND cover
  // the single-column filters used by count queries (leftmost-prefix rule).
  @@index([followingId, createdAt]) // followers list + follower count
  @@index([followerId, createdAt]) // following list + following count
}

model Notification {
  id String @id @default(cuid())

  // Who receives it.
  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Who caused it. Null for SYSTEM notifications. SetNull (not Cascade) so a
  // deleted actor doesn't erase the recipient's history.
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type NotificationType

  // What it points at, for deep links. entityType tells the client how to route.
  entityType String? // 'BLOG' | 'COMMENT' | 'USER'
  entityId   String?

  // Render inputs (blogTitle, commentExcerpt, ...) — NOT rendered text. Storing
  // a finished string would freeze it: a renamed user leaves stale copy behind
  // and UserSettings.language could never be honoured.
  metadata Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  /// Idempotency key: one notification per (recipient, event occurrence). Makes a
  /// retried fan-out job a no-op via createMany(skipDuplicates) / P2002.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]
  // NOTE: the unread COUNT is served by a partial index that Prisma cannot
  // express — see prisma/sql/notification_unread_idx.sql, applied by db:indexes.

  @@index([recipientId, createdAt]) // the list query, newest-first
  @@index([recipientId, isRead, createdAt]) // filtered list (unread only)
  @@index([entityType, entityId]) // future: "notifications about this blog"
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // In-app is deliberately NOT tracked: it has no delivery semantics, and a row
  // per in-app notification would double the write volume of every fan-out.
  channel  DeliveryChannel
  provider String? // 'resend' | 'log' | ...

  providerMessageId String?
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)

  sentAt   DateTime?
  failedAt DateTime?
  error    String?   @db.Text

  createdAt DateTime @default(now())

  @@unique([notificationId, channel]) // one delivery record per channel
  @@index([status, createdAt]) // retry sweeps / failure dashboards
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------
// Both tables are DAILY aggregates, written only by the analytics flush worker
// and never by a request. Nothing here is incremented on the HTTP path — that is
// the whole point of the module: high-frequency events accumulate in Redis and
// land here in batches, so a viral blog costs one row-lock per flush cycle
// rather than one per reader.
//
// Weekly and monthly reporting is NOT stored. It is derived at query time with
// `date_trunc`, because a rollup table is duplicated state that has to be kept
// consistent with its source, and daily rows are already small enough to
// aggregate on demand (one row per blog per day).
//
// Counters are GROSS, never net: `bookmarks` and `unbookmarks` are recorded
// separately so a day's row stays an immutable record of what happened, and net
// change is a subtraction at read time. A single net column could not
// distinguish "no activity" from "ten added, ten removed".

/// Per-blog, per-day metrics. The unit of both blog analytics and — via the
/// denormalized `authorId` — author analytics.
model BlogAnalyticsDaily {
  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  /// Denormalized from Blog.authorId. Present so an author's time series is a
  /// single-table aggregate instead of a join against Blog on every dashboard
  /// load — see @@index([authorId, date]). Safe to denormalize because
  /// authorship is immutable in this schema (there is no transfer feature); if
  /// one is ever added, it must backfill this column.
  authorId String
  author   User   @relation("BlogAnalyticsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// UTC calendar day. DATE, not timestamp: the grain IS the day, and a
  /// timestamp would invite a row per hour to creep in through a bad upsert.
  date DateTime @db.Date

  /// Deduplicated views — repeat opens by the same reader inside the dedupe
  /// window collapse into one. NOT raw page loads.
  views Int @default(0)

  /// Distinct readers, from a per-day HyperLogLog. APPROXIMATE (~0.81% standard
  /// error) and written absolutely rather than incrementally, unlike every other
  /// column here. See ANALYTICS_MODULE.md.
  uniqueViews Int @default(0)

  readStarts      Int @default(0)
  readCompletions Int @default(0)

  /// Summed, validated, clamped reading seconds. Average read time is
  /// totalReadingSeconds / readCompletions — stored as a sum so the average is
  /// recomputable over any date range, which a stored average is not.
  totalReadingSeconds Int @default(0)

  bookmarks   Int @default(0)
  unbookmarks Int @default(0)

  /// Comments left by OTHER users. An author answering their own thread is
  /// participation, not audience engagement.
  comments Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// (blogId, date) is the PRIMARY KEY, not a surrogate id with a unique index
  /// beside it. It is the row's real identity — an aggregate for a blog on a day
  /// is unique by definition — so a synthetic key would add a column and a
  /// second index that nothing ever looks anything up by. It is also the upsert
  /// target: `ON CONFLICT ("blogId", "date")`.
  @@id([blogId, date])
  /// Author dashboards: "my views over the last 90 days" reads this alone.
  /// Leading authorId (not date) because every author query is scoped to one
  /// author first and a range second.
  @@index([authorId, date])
  /// Retention pruning and future platform-wide rollups scan by date only.
  @@index([date])
}

/// Per-user, per-day metrics that are NOT blog-scoped. Audience growth lives
/// here; everything view/engagement-shaped rolls up from BlogAnalyticsDaily by
/// authorId instead, so no metric is maintained in two places.
model UserAnalyticsDaily {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  followersGained Int @default(0)
  followersLost   Int @default(0)

  /// Blogs this user published on this day. A publishing-cadence signal — the
  /// CURRENT published total is read live from Blog, never summed from here,
  /// because unpublishing would make the sum drift from the truth.
  blogsPublished Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Moderation & Administration
// ---------------------------------------------------------------------------
// Two tables, and deliberately only two: what the community FLAGGED (Report)
// and what a moderator DID (ModerationAction). Everything a moderation decision
// changes — a blog's `isHidden`, a comment's `isHidden`, a user's `status` —
// stays in the table owned by the module that owns that concept, written
// through that module's service. Moderation never writes another module's rows,
// so there is exactly one definition of "is this blog visible" and moderation
// is not a second one.
//
// Both tables are polymorphic over `targetType` + `targetId` with NO foreign key
// to the target. That is a deliberate trade: a real FK would need one nullable
// column and one relation per target type, and adding a fifth reportable thing
// would be a migration on both tables plus a schema change on User. The cost is
// that a dangling `targetId` is possible (its blog was hard-deleted) — handled
// at read time by hydrating targets in a batch and rendering the ones that
// resolve. See MODERATION_MODULE.md § Database design.

/// What a user can report. Narrower than ModerationTargetType: REPORT is a
/// moderation target (a report gets claimed and resolved) but is not something
/// a member of the public can file a report about.
enum ReportTargetType {
  BLOG
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  SELF_HARM
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

/// Who filed it. AUTOMATED reports come from the content-evaluation provider
/// (see `moderation/providers`) and carry no reporter. Kept as a column rather
/// than inferred from `reporterId IS NULL`, because a report whose reporter was
/// later erased is not the same thing as one the platform raised itself.
enum ReportSource {
  USER
  AUTOMATED
}

enum ModerationTargetType {
  BLOG
  COMMENT
  USER
  REPORT
}

/// The audit vocabulary. Adding an action is one entry here and one service
/// method — the log's shape (actor, action, target, reason, metadata) is
/// deliberately generic enough that no future action needs a schema change.
enum ModerationActionType {
  CONTENT_HIDDEN
  CONTENT_RESTORED
  CONTENT_DELETED
  USER_SUSPENDED
  USER_UNSUSPENDED
  REPORT_CLAIMED
  REPORT_RESOLVED
  REPORT_DISMISSED
}

/// A flag raised against content or an account.
///
/// A report is a REQUEST for review, never a decision: nothing about a report
/// changes what is visible on the platform. Only a ModerationAction does that.
model Report {
  id String @id @default(cuid())

  /// Null for AUTOMATED reports, and for a reporter whose account was erased.
  /// SetNull rather than Cascade: deleting the reporter must not delete the
  /// moderation history of the thing they reported.
  reporterId String?
  reporter   User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  source     ReportSource @default(USER)

  targetType ReportTargetType
  targetId   String

  /// The account that owns the reported thing (the blog's author, the comment's
  /// author, or the reported user themselves), denormalized at report time.
  ///
  /// Present so the queue can group by offender and so a moderator can see
  /// "this account has six open reports" without a join per row against three
  /// different tables — the N+1 that a polymorphic target otherwise guarantees.
  /// Not a foreign key, for the same reason `targetId` is not.
  targetOwnerId String?

  reason      ReportReason
  description String?      @db.Text

  status ReportStatus @default(PENDING)

  /// Claiming: a moderator takes the report before acting on it. The claim is a
  /// conditional UPDATE (see report.repository), so two moderators opening the
  /// same queue row cannot both take it.
  assignedToId String?
  assignedTo   User?     @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  resolvedById     String?
  resolvedBy       User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolutionReason String?   @db.Text

  /// Provider output for AUTOMATED reports (score, matched rules), and nothing
  /// else. Never render inputs — the queue reads the target live.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions ModerationAction[]
  // NOTE: duplicate suppression is a PARTIAL UNIQUE index over OPEN reports
  // only, which Prisma cannot express — see prisma/sql/moderation_indexes.sql,
  // applied by `npm run db:indexes`.

  /// The queue's own index: every queue page filters on status and walks
  /// (createdAt, id). Trailing `id` makes the ordering total, which is what
  /// makes the keyset cursor exact when two reports share a millisecond.
  @@index([status, createdAt, id])
  /// The unfiltered queue ("everything, newest first") and the date-range
  /// filter, neither of which can use the status-leading index above.
  @@index([createdAt, id])
  /// "What else has been reported about this thing" — the report detail view,
  /// and the duplicate check that runs on every submission.
  @@index([targetType, targetId, status])
  /// "This account's record" — reports about everything one user owns, newest
  /// first. Ordered (owner, createdAt, id) rather than (owner, status, createdAt)
  /// because the status filter is a two-value IN, not an equality: with status
  /// in the middle the planner can seek on the owner but then has to SORT, while
  /// this ordering walks the index and filters the handful of scoped rows on the
  /// heap. Verified with `npm run moderation:report`.
  @@index([targetOwnerId, createdAt, id])
  /// A moderator's own claimed queue.
  @@index([assignedToId, status, createdAt])
  /// A reporter's own history, and the per-reporter abuse check.
  @@index([reporterId, createdAt])
}

/// The append-only moderation audit log.
///
/// Every administrative action writes exactly one row here, in the same
/// transaction as the change it records where the change is local, and
/// immediately after where the change belongs to another module's service.
/// UPDATE and DELETE are refused by a database trigger, so "append-only" is a
/// property of the table rather than a convention the code is trusted to keep —
/// see prisma/sql/moderation_indexes.sql.
model ModerationAction {
  id String @id @default(cuid())

  /// The moderator who acted. Always from the authenticated request, never from
  /// the body. Restrict (not Cascade/SetNull) so an audit row can never be
  /// orphaned or erased by touching the actor's account — the platform
  /// soft-deletes users, so this never blocks a real operation.
  actorId String
  actor   User   @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  action     ModerationActionType
  targetType ModerationTargetType
  targetId   String

  /// The account affected — the content's author, or the suspended user.
  /// Denormalized so "everything ever done to this user's account and content"
  /// is one index scan rather than a fan-out over their blogs and comments.
  subjectUserId String?

  /// The report this action resolved, when it came from the queue. Null for a
  /// direct action a moderator took without one.
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  reason   String? @db.Text
  /// Action-specific detail (previous status, blog slug, comment excerpt).
  /// The extension point that lets a new action type record what it needs
  /// without a migration.
  metadata Json?

  createdAt DateTime @default(now())
  // No updatedAt, deliberately: a row that can be updated is not an audit log.

  /// The global history feed, newest-first with a total order for the cursor.
  @@index([createdAt, id])
  /// "Everything done to this blog / comment / account."
  @@index([targetType, targetId, createdAt])
  /// "Everything this moderator did" — the review-the-reviewer query.
  @@index([actorId, createdAt])
  /// Filtered history ("all suspensions last week").
  @@index([action, createdAt])
  /// One user's full moderation record across all their content.
  @@index([subjectUserId, createdAt])
}
