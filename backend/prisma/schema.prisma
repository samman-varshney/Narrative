// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum BlogVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  MEMBERS_ONLY
}

enum MediaResourceType {
  IMAGE
  VIDEO // reserved — not built yet
  DOCUMENT // reserved — not built yet
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  username     String  @unique
  bio          String? @db.Text
  avatar       String? // denormalized secureUrl of the current avatar (kept for convenience)
  role         Role    @default(USER)

  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 Relations
  profile          UserProfile?
  developerProfile DeveloperProfile?
  settings         UserSettings?

  // 1:N Relations
  blogs     Blog[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  notifications Notification[]
  sessions      Session[]
  skills        UserSkill[]
  media         Media[]       @relation("MediaUploader")

  // Current avatar as a proper reference to its Media record (source of truth).
  avatarMediaId String? @unique
  avatarMedia   Media?  @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([name])
}

model Media {
  id               String            @id @default(cuid())
  publicId         String            @unique // cloudinary public_id OR local filename
  url              String
  secureUrl        String
  originalFilename String
  mimeType         String // derived from sharp inspection, NOT the client-provided value
  extension        String
  fileSize         Int
  width            Int?
  height           Int?
  resourceType     MediaResourceType @default(IMAGE)
  provider         String // 'local' | 'cloudinary'
  checksum         String? // sha256 hex of the stored bytes
  metadata         Json? // { context, format, altText, ... }

  uploadedById String
  uploadedBy   User   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // Back-relation for the user whose current avatar this media is (if any).
  avatarOf User? @relation("UserAvatar")

  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([uploadedById])
  @@index([deletedAt])
  @@index([resourceType])
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location   String?
  occupation String?
  company    String?
}

model DeveloperProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  github        String?
  linkedin      String?
  portfolio     String?
  stackoverflow String?
  leetcode      String?
  codeforces    String?
  hackerrank    String?
  x             String?
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme    String @default("system")
  language String @default("en")
  timezone String @default("UTC")

  isPrivate    Boolean @default(false)
  hideEmail    Boolean @default(true)
  hideActivity Boolean @default(false)

  emailPreferences        Json?
  notificationPreferences Json?
}

model Blog {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  subtitle   String?
  content    Json?
  coverImage String?

  status     BlogStatus     @default(DRAFT)
  visibility BlogVisibility @default(PUBLIC)

  readingTimeMinutes Int @default(0)
  wordCount          Int @default(0)
  charCount          Int @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  seo       BlogSEO?
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  tags       Tag[]      @relation("BlogTags")
  categories Category[] @relation("BlogCategories")

  @@index([slug])
  @@index([authorId])
  @@index([status])
}

model BlogSEO {
  id              String  @id @default(cuid())
  blogId          String  @unique
  blog            Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  twitterCard     String?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs Blog[] @relation("BlogCategories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs Blog[] @relation("BlogTags")
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId])
  @@index([authorId])
  @@index([parentId])
}

model Like {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate likes
  @@index([blogId])
  @@index([userId])
}

model Bookmark {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blogId, userId]) // Prevent duplicate bookmarks
  @@index([blogId])
  @@index([userId])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId]) // Prevent duplicate follows
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // e.g., 'NEW_FOLLOWER', 'BLOG_LIKED', 'COMMENT_RECEIVED'
  sourceId String? // ID of the related entity (e.g., Blog ID or User ID)
  message  String
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
}
